{
  "name": "PUCP-LAB-M1",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "make install",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
